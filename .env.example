# Environment Variables for AI Resume Builder Backend — copy to .env (never commit .env)

# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_resume_builder

# Clerk Auth (required)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# --- AI Provider (OpenRouter preferred) ---
# OpenRouter (recommended) — get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: app attribution for OpenRouter rankings
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=AI Resume Builder
# Model for OpenRouter — examples: deepseek/deepseek-chat, openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct
AI_MODEL=deepseek/deepseek-chat
# OPENROUTER_MODEL is alias for AI_MODEL
# OPENROUTER_MODEL=deepseek/deepseek-chat

# Legacy NVIDIA fallback (still supported if OPENROUTER_API_KEY not set)
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=deepseek-ai/deepseek-v3.1-terminus

# CORS — comma-separated allowed origins (required in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Analytics retention (days, default 90)
ANALYTICS_TTL_DAYS=90

# LinkedIn import (optional) — RapidAPI key for "Fresh LinkedIn Profile Data". Kept server-side only.
RAPIDAPI_KEY=
# RAPIDAPI_LINKEDIN_HOST=fresh-linkedin-profile-data-api.p.rapidapi.com
